{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "legacy/models/party.model.ts", "legacy/models/vote.model.ts", "legacy/models/voter.model.ts", "legacy/models/district.model.ts"],
  "exclude": ["node_modules", "dist"]
}